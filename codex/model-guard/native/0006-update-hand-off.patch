+    #[test]
+    fn model_guard_packages_are_recognized_by_installation_root() {
+        let home = tempfile::tempdir().expect("temp dir");
+        let package = home.path().join("native/1.9.0-abcd1234/bin");
+        std::fs::create_dir_all(&package).expect("package dir");
+        let exe = package.join("codex");
+        std::fs::write(&exe, b"").expect("exe");
+        let entry = home.path().join("bin");
+        std::fs::create_dir_all(&entry).expect("entry dir");
+        std::os::unix::fs::symlink(&exe, entry.join("codex")).expect("entry link");
+        assert!(runs_from_model_guard(Some(home.path()), Some(&exe)));
+        assert!(runs_from_model_guard(
+            Some(home.path()),
+            Some(&entry.join("codex"))
+        ));
+        let elsewhere = home.path().join("official");
+        std::fs::create_dir_all(&elsewhere).expect("official dir");
+        std::fs::write(elsewhere.join("codex"), b"").expect("official exe");
+        assert!(!runs_from_model_guard(
+            Some(home.path()),
+            Some(&elsewhere.join("codex"))
+        ));
+        assert!(!runs_from_model_guard(None, Some(&exe)));
+        assert!(!runs_from_model_guard(Some(home.path()), None));
+        assert_eq!(
+            UpdateAction::ModelGuard.command_args(),
+            ("model-guard-codex", &["update"][..])
+        );
+    }
