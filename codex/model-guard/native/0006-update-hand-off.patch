 #[cfg(not(debug_assertions))]
 pub fn get_update_action() -> Option<UpdateAction> {
+    let root = std::env::var_os("MODEL_GUARD_CODEX_HOME")
+        .map(std::path::PathBuf::from)
+        .or_else(|| dirs::home_dir().map(|home| home.join(".local/share/model-guard-codex")));
+    if runs_from_model_guard(root.as_deref(), std::env::current_exe().ok().as_deref()) {
+        return Some(UpdateAction::ModelGuard);
+    }
     UpdateAction::from_install_context(InstallContext::current())
 }
 
+/// Whether `exe` is one of the versioned native packages under the Model
+/// Guard installation root. Both paths are canonicalized, so the entry
+/// symlink and the package directory are compared by what they resolve to.
+#[cfg(any(not(debug_assertions), test))]
+fn runs_from_model_guard(root: Option<&std::path::Path>, exe: Option<&std::path::Path>) -> bool {
+    let (Some(root), Some(exe)) = (root, exe) else {
+        return false;
+    };
+    match (
+        std::fs::canonicalize(root.join("native")),
+        std::fs::canonicalize(exe),
+    ) {
+        (Ok(native), Ok(exe)) => exe.starts_with(native),
+        _ => false,
+    }
+}
