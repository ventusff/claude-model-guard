@@ -0,0 +1,248 @@
+//! Native footer content and on-demand evidence details.
+use super::*;
+use ratatui::style::Color;
+
+impl ChatWidget {
+    pub(in crate::chatwidget) fn model_guard_lines(&self) -> Option<Vec<Line<'static>>> {
+        let guard = self.model_guard.as_ref()?;
+        let zh = guard.settings.language == "zh";
+        let running = guard.running && !guard.suspended;
+        let active = running.then_some(guard.route.as_ref()).flatten();
+        let (model, effort) = if let Some(route) = active {
+            (
+                route.requested_model.as_str(),
+                route.reasoning_effort.clone(),
+            )
+        } else {
+            (
+                self.current_model(),
+                self.current_reasoning_effort()
+                    .map(|effort| effort.to_string()),
+            )
+        };
+        let mut parts = vec![format!(
+            "{} {model}",
+            if active.is_some() {
+                if zh { "请求" } else { "request" }
+            } else if zh {
+                "已选"
+            } else {
+                "selected"
+            }
+        )];
+        if let Some(effort) = effort {
+            parts.push(effort);
+        }
+        if guard.settings.show_account {
+            if self.config.model_provider_id != "openai" {
+                parts.push(self.config.model_provider_id.clone());
+            } else if let Some(account) = self.status_account_display.as_ref() {
+                match account {
+                    StatusAccountDisplay::ChatGpt { email, plan } => {
+                        parts.extend(email.iter().cloned());
+                        parts.extend(plan.iter().cloned());
+                    }
+                    StatusAccountDisplay::ApiKey => parts.push("API key".into()),
+                }
+            }
+        }
+        if let Some(actual) = active.and_then(|route| route.server_model.as_deref())
+            && guard.mismatch.is_none()
+        {
+            parts.push(format!(
+                "{} {actual}",
+                if zh {
+                    "服务端披露"
+                } else {
+                    "server reported"
+                }
+            ));
+        }
+        let mut lines = vec![Line::from(format!(" {}", safe_label(&parts.join(" · ")))).dim()];
+        let previous = if running {
+            ""
+        } else if zh {
+            "上轮 · "
+        } else {
+            "last turn · "
+        };
+        let evidence_visible =
+            running || guard.turn_scope.as_ref() == Some(&self.model_guard_selected_scope());
+        let warning = if !evidence_visible {
+            None
+        } else if let Some((from, to)) = guard.mismatch.as_ref() {
+            Some(format!(
+                "{previous}{} {from} → {to}",
+                if zh { "路由变化" } else { "ROUTE DIFF" }
+            ))
+        } else if let Some((from, to)) = guard.label_mismatch.as_ref() {
+            Some(if zh {
+                format!("{previous}响应标注 {to} · 请求 {from}（正文标签，非响应头）")
+            } else {
+                format!(
+                    "{previous}Response labeled {to} · requested {from} (body label, not a header)"
+                )
+            })
+        } else if guard.alert() == "suspect" {
+            let hits = guard
+                .samples
+                .iter()
+                .rev()
+                .take(5)
+                .filter(|&&n| n == 516)
+                .count();
+            Some(if zh {
+                format!("{previous}推理异常信号：最近 5 次响应中有 {hits} 次为 516 tokens")
+            } else {
+                format!(
+                    "{previous}Reasoning anomaly signal: {hits} of the last 5 responses used 516 tokens"
+                )
+            })
+        } else {
+            None
+        };
+        if let Some(warning) = warning {
+            let style = if guard.mismatch.is_some() {
+                Style::default()
+                    .fg(Color::Rgb(255, 241, 242))
+                    .bg(Color::Rgb(127, 29, 29))
+            } else if guard.label_mismatch.is_some() {
+                Style::default()
+                    .fg(Color::Rgb(255, 237, 213))
+                    .bg(Color::Rgb(124, 45, 18))
+            } else {
+                Style::default()
+                    .fg(Color::Rgb(254, 243, 199))
+                    .bg(Color::Rgb(78, 40, 0))
+            };
+            lines.push(Line::from(format!(" {}", safe_label(&warning))).style(style));
+        }
+        Some(lines)
+    }
+
+    pub(in crate::chatwidget) fn add_model_guard_details(&mut self) {
+        let Some(guard) = self.model_guard.as_ref() else {
+            return;
+        };
+        let zh = guard.settings.language == "zh";
+        let mut details: Vec<Line<'static>> = vec!["Model Guard".bold().into()];
+        if let Some(route) = guard.route.as_ref() {
+            details.push(
+                format!(
+                    "{}: {} · {}",
+                    if zh { "最近请求" } else { "Last request" },
+                    safe_label(&route.requested_model),
+                    safe_label(route.reasoning_effort.as_deref().unwrap_or("default"))
+                )
+                .into(),
+            );
+            if let Some(actual) = route.server_model.as_ref() {
+                details.push(
+                    format!(
+                        "{}: {}",
+                        if zh {
+                            "服务端披露"
+                        } else {
+                            "Server reported"
+                        },
+                        safe_label(actual)
+                    )
+                    .into(),
+                );
+            } else {
+                details.push(
+                    if zh {
+                        "本次响应没有提供有效模型标识。"
+                    } else {
+                        "This response did not disclose an effective model."
+                    }
+                    .into(),
+                );
+            }
+            details.push(
+                match route.response_label.as_deref() {
+                    Some(label) if zh => format!("响应正文标签: {}", safe_label(label)),
+                    Some(label) => format!("Response body label: {}", safe_label(label)),
+                    None if zh => "响应正文没有模型标签。".to_owned(),
+                    None => "The response body carried no model label.".to_owned(),
+                }
+                .into(),
+            );
+        } else {
+            details.push(
+                if zh {
+                    "尚无本会话的实时路由观测。"
+                } else {
+                    "No live routing observation for this session yet."
+                }
+                .into(),
+            );
+        }
+        if let Some((from, to)) = guard.mismatch.as_ref() {
+            details.push(
+                format!(
+                    "{}: {} → {}",
+                    if zh {
+                        "本轮曾披露"
+                    } else {
+                        "Disclosed earlier this turn"
+                    },
+                    safe_label(from),
+                    safe_label(to)
+                )
+                .into(),
+            );
+        }
+        if let Some((from, to)) = guard.label_mismatch.as_ref() {
+            details.push(
+                format!(
+                    "{}: {} → {}",
+                    if zh {
+                        "本轮正文标签曾不同于请求"
+                    } else {
+                        "Body label differed from the request this turn"
+                    },
+                    safe_label(from),
+                    safe_label(to)
+                )
+                .into(),
+            );
+        }
+        if let Some(tokens) = guard.last_tokens {
+            details.push(
+                format!(
+                    "{}: {tokens} tokens",
+                    if zh {
+                        "上次推理用量"
+                    } else {
+                        "Last reasoning usage"
+                    }
+                )
+                .into(),
+            );
+        }
+        let count = guard.samples.len();
+        let hits = guard.samples.iter().filter(|&&n| n == 516).count();
+        details.push(if zh {
+            format!("最近 {count} 次有效响应中，{hits} 次恰好为 516 个推理 tokens。")
+        } else {
+            format!("{hits} of the last {count} measured responses used exactly 516 reasoning tokens.")
+        }.into());
+        details.push(if zh {
+            "516 是辅助异常信号；服务端标识和用量均不能独立证明底层模型权重。"
+        } else {
+            "516 is an auxiliary signal. Server labels and usage do not attest the underlying weights."
+        }.dim().into());
+        self.add_to_history(PlainHistoryCell::new(details));
+    }
+}
+
+fn safe_label(value: &str) -> String {
+    value
+        .chars()
+        .filter(|c| {
+            !c.is_control() && !matches!(*c, '\u{202a}'..='\u{202e}' | '\u{2066}'..='\u{2069}')
+        })
+        .take(512)
+        .collect()
+}
